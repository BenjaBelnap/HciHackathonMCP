# Environment Variables for Oracle Clarity Database

# Oracle SYSTEM user password (used by the container)
ORACLE_PASSWORD=OraclePassword123

# CLARITY user credentials (created by init scripts)
# Username: CLARITY
# Password: Clarity123
# Service: XEPDB1

# Connection Details for your application
# Use these values in src/services/dataObjectQueryService/.env
ORACLE_USERNAME=CLARITY
ORACLE_PASSWORD=Clarity123
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
